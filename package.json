{
  "name": "roleplay-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --disable-warning=ExperimentalWarning --watch server/src/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.js",
    "test:pg": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 server/test/accounts.test.js",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "playwright-core": "1.56",
    "vite": "^6.4.4"
  }
}
