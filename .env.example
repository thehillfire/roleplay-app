PORT=3000

# Database. Leave DATABASE_URL empty to use SQLite at SQLITE_FILE (fine for one server).
# For production use Postgres, e.g. Supabase/Neon:
#   DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=
SQLITE_FILE=data/kindred.db

# Comma-separated emails that become moderators when they sign up or log in.
ADMIN_EMAILS=

# Extra origins allowed to open the realtime WebSocket (comma-separated), if the
# client is served from a different domain than the API.
ALLOWED_ORIGINS=

# Payments for Connect (mutual reveal). Leave empty and connecting is free.
# In Stripe: create a webhook to https://<your-domain>/api/billing/webhook for
# the checkout.session.completed event and paste its signing secret here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CONNECT_PRICE_CENTS=999
CONNECT_CURRENCY=usd
# Kindred Plus monthly price (3 connect credits/month + more daily matches).
PLUS_PRICE_CENTS=499

# Web push notifications. Generate keys with `npm run vapid`. Leave empty to disable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email (password reset). Without RESEND_API_KEY, emails are printed to the server log.
RESEND_API_KEY=
MAIL_FROM=Kindred <no-reply@yourdomain.com>
# Public address used in emailed links, e.g. https://kindred.example.com
PUBLIC_URL=

# Google AdSense on the home screen only (never in chats; non-personalized). Both or neither.
ADSENSE_CLIENT=
ADSENSE_SLOT=

# Post server errors to a Slack or Discord incoming webhook (error type + route only, rate-limited).
ERROR_WEBHOOK_URL=

# Proxies in front of Node (Render/Fly/Heroku/nginx: 1). Use 0 if Node is reachable directly,
# otherwise anyone can fake X-Forwarded-For to dodge rate limits.
TRUST_PROXY=1

# Cloudflare Turnstile bot check at signup (free: dash.cloudflare.com → Turnstile). Both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sign-up/login/reset attempts per IP per minute (raise only for test servers).
AUTH_RATE_LIMIT=10

# New people someone can be matched with per 24 hours (stops troll cycling).
DAILY_MATCH_LIMIT=40

# Request logging (one JSON line per API call, no bodies or query strings). "off" to silence.
REQUEST_LOG=on

# Messages older than this many days are deleted daily (0 = keep forever).
MESSAGE_RETENTION_DAYS=365
# Deleted accounts' messages and reports are kept this long for safety review.
DELETED_RETENTION_DAYS=90

# Optional ML screening on top of the built-in rules (free with an OpenAI API key).
# Sends message text to OpenAI's moderation endpoint: disclose it in the privacy policy.
# Fails open: if it's slow or down, the rules alone decide.
MODERATION_PROVIDER=
OPENAI_API_KEY=

# Android app (Trusted Web Activity, see docs/ANDROID.md). Both are needed for
# /.well-known/assetlinks.json, which hides the browser bar in the Play Store app.
ANDROID_PACKAGE_NAME=
# The app signing key's SHA-256 fingerprint (Play Console → App integrity). Comma-separate several.
ANDROID_CERT_SHA256=
