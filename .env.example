# Google AI Studio key. Leave empty to use the offline narrator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000

# Database. Leave DATABASE_URL empty to use SQLite at SQLITE_FILE (fine for one server).
# For Vercel or multiple servers, use Postgres, e.g. Supabase/Neon:
#   DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=
SQLITE_FILE=data/loreforge.db
